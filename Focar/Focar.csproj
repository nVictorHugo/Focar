<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Resources\Images\certificate.png" />
		<None Remove="Resources\Images\key.png" />
		<None Remove="Resources\Images\logo.ico" />
		<None Remove="Resources\Images\logos.ico" />
		<None Remove="Resources\Images\tecnica-pomodoro.png" />
		<None Remove="Resources\Sounds\discord-notification.mp3" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Constants\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="MaterialDesignColors" Version="5.3.2" />
		<PackageReference Include="MaterialDesignThemes" Version="5.3.2" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
		<PackageReference Include="NAudio" Version="2.3.0" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Resources\Images\certificate.png" />
		<Resource Include="Resources\Images\key.png" />
		<Resource Include="Resources\Images\logo.ico" />
		<Resource Include="Resources\Images\logos.ico" />
		<Resource Include="Resources\Images\tecnica-pomodoro.png" />
		<Resource Include="Resources\Sounds\discord-notification.mp3">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Resource>
	</ItemGroup>

	<PropertyGroup>
		<ApplicationIcon>Resources/Images/logo.ico</ApplicationIcon>
	</PropertyGroup>
</Project>
