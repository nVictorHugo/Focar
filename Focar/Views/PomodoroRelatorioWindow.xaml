<Window x:Class="Focar.Views.PomodoroRelatorioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Focar.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Focar.ViewModels"
        mc:Ignorable="d"
        Title="Focar :: Relatório do pomodoro"
        Icon="/Resources/Images/logo.ico"
        Width="1000"
        Height="620"
        MinWidth="700"
        MinHeight="450"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterScreen">

	<Window.DataContext>
		<vm:PomodoroRelatorioViewModel />
	</Window.DataContext>

	<Window.Resources>
		<BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
	</Window.Resources>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Cabeçalho -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
			<materialDesign:PackIcon Kind="ChartTimelineVariant"
			                          Width="28" Height="28"
			                          VerticalAlignment="Center"
			                          Foreground="{DynamicResource PrimaryHueMidBrush}" />
			<TextBlock Text="Histórico do Pomodoro"
			           Style="{DynamicResource MaterialDesignHeadline5TextBlock}"
			           Margin="10,0,0,0"
			           VerticalAlignment="Center" />
		</StackPanel>

		<!-- Filtros -->
		<materialDesign:Card Grid.Row="1" Padding="12" Margin="0,0,0,16">
			<StackPanel Orientation="Horizontal">
				<ComboBox Width="150"
				          Margin="0,0,12,0"
				          materialDesign:HintAssist.Hint="Tipo"
				          Style="{DynamicResource MaterialDesignOutlinedComboBox}"
				          ItemsSource="{Binding OpcoesTipo}"
				          SelectedItem="{Binding TipoFiltro, UpdateSourceTrigger=PropertyChanged}" />

				<DatePicker Width="150"
				            Margin="0,0,12,0"
				            materialDesign:HintAssist.Hint="De"
				            Style="{DynamicResource MaterialDesignOutlinedDatePicker}"
				            SelectedDate="{Binding DataInicio, UpdateSourceTrigger=PropertyChanged}" />

				<DatePicker Width="150"
				            Margin="0,0,12,0"
				            materialDesign:HintAssist.Hint="Até"
				            Style="{DynamicResource MaterialDesignOutlinedDatePicker}"
				            SelectedDate="{Binding DataFim, UpdateSourceTrigger=PropertyChanged}" />

				<Button Style="{DynamicResource MaterialDesignOutlinedButton}"
				        Command="{Binding LimparFiltrosCommand}"
				        Margin="0,0,8,0"
				        VerticalAlignment="Center">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="FilterRemoveOutline" VerticalAlignment="Center" />
						<TextBlock Text="Limpar" Margin="6,0,0,0" />
					</StackPanel>
				</Button>

				<Button Style="{DynamicResource MaterialDesignIconButton}"
				        Command="{Binding CarregarCommand}"
				        ToolTip="Atualizar"
				        VerticalAlignment="Center">
					<materialDesign:PackIcon Kind="Refresh" />
				</Button>
			</StackPanel>
		</materialDesign:Card>

		<!-- Cards de resumo -->
		<StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
			<materialDesign:Card Padding="16" Margin="0,0,12,0">
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon Kind="FormatListBulleted"
					                          Width="22" Height="22"
					                          VerticalAlignment="Center"
					                          Foreground="{DynamicResource PrimaryHueMidBrush}" />
					<TextBlock Text="{Binding TotalRegistrosTexto}"
					           Margin="10,0,0,0"
					           VerticalAlignment="Center"
					           Style="{DynamicResource MaterialDesignBody1TextBlock}" />
				</StackPanel>
			</materialDesign:Card>

			<materialDesign:Card Padding="16">
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon Kind="ClockOutline"
					                          Width="22" Height="22"
					                          VerticalAlignment="Center"
					                          Foreground="{DynamicResource PrimaryHueMidBrush}" />
					<TextBlock Text="{Binding TempoFocadoTexto}"
					           Margin="10,0,0,0"
					           VerticalAlignment="Center"
					           Style="{DynamicResource MaterialDesignBody1TextBlock}" />
				</StackPanel>
			</materialDesign:Card>
		</StackPanel>

		<!-- Grid de registros -->
		<Grid Grid.Row="3">
			<materialDesign:Card Padding="0">
				<DataGrid ItemsSource="{Binding Registros}"
				          SelectedItem="{Binding RegistroSelecionado}"
				          AutoGenerateColumns="False"
				          CanUserAddRows="False"
				          CanUserDeleteRows="False"
				          IsReadOnly="True"
				          HeadersVisibility="Column"
				          GridLinesVisibility="Horizontal"
				          materialDesign:DataGridAssist.CellPadding="12,10"
				          materialDesign:DataGridAssist.ColumnHeaderPadding="12,10">
					<DataGrid.Columns>
						<DataGridTemplateColumn Header="Tipo" Width="140">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon Kind="{Binding TipoIcone}"
										                          VerticalAlignment="Center"
										                          Foreground="{DynamicResource PrimaryHueMidBrush}" />
										<TextBlock Text="{Binding TipoDescricao}"
										           Margin="8,0,0,0"
										           VerticalAlignment="Center" />
									</StackPanel>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<DataGridTextColumn Header="Início"
						                    Binding="{Binding InicioEm, StringFormat=dd/MM/yyyy HH:mm}"
						                    Width="160" />

						<DataGridTextColumn Header="Fim"
						                    Binding="{Binding FimEm, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue='—'}"
						                    Width="160" />

						<DataGridTextColumn Header="Duração"
						                    Binding="{Binding DuracaoFormatada}"
						                    Width="150" />

						<DataGridTemplateColumn Header="Status" Width="130">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<materialDesign:Chip Content="{Binding StatusDescricao}"
									                      IsHitTestVisible="False">
										<materialDesign:Chip.Style>
											<Style TargetType="materialDesign:Chip">
												<Setter Property="Background" Value="#E0E0E0" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding Concluida}" Value="True">
														<Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</materialDesign:Chip.Style>
									</materialDesign:Chip>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>

						<DataGridTemplateColumn Header="Ações" Width="*">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<Button Style="{DynamicResource MaterialDesignIconButton}"
									        ToolTip="Excluir registro"
									        Command="{Binding DataContext.ExcluirRegistroCommand,
									                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
									        CommandParameter="{Binding}">
										<materialDesign:PackIcon Kind="TrashCanOutline"
										                          Foreground="{DynamicResource ValidationErrorBrush}" />
									</Button>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
					</DataGrid.Columns>
				</DataGrid>
			</materialDesign:Card>

			<StackPanel Visibility="{Binding ListaVazia, Converter={StaticResource BooleanToVisibilityConverter}}"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center">
				<materialDesign:PackIcon Kind="TimerSandEmpty"
				                          Width="48" Height="48"
				                          HorizontalAlignment="Center"
				                          Opacity="0.5" />
				<TextBlock Text="Nenhum registro encontrado"
				           Margin="0,8,0,0"
				           Opacity="0.6"
				           Style="{DynamicResource MaterialDesignBody1TextBlock}" />
			</StackPanel>

			<ProgressBar Style="{DynamicResource MaterialDesignCircularProgressBar}"
			             IsIndeterminate="True"
			             Width="32" Height="32"
			             Visibility="{Binding Carregando, Converter={StaticResource BooleanToVisibilityConverter}}" />
		</Grid>

		<!-- Ações inferiores -->
		<StackPanel Grid.Row="4"
		            Orientation="Horizontal"
		            HorizontalAlignment="Right"
		            Margin="0,16,0,0">
			<!--<Button Style="{DynamicResource MaterialDesignOutlinedButton}"
			        Foreground="{DynamicResource ValidationErrorBrush}"
			        BorderBrush="{DynamicResource ValidationErrorBrush}"
			        Command="{Binding ExcluirTodosCommand}"
			        Margin="0,0,12,0">
				<StackPanel Orientation="Horizontal">
					<materialDesign:PackIcon Kind="DeleteSweepOutline" VerticalAlignment="Center" />
					<TextBlock Text="Excluir todos" Margin="6,0,0,0" />
				</StackPanel>
			</Button>-->

			<Button Style="{DynamicResource MaterialDesignRaisedButton}"
			        Click="BotaoFechar_Click">
				<TextBlock Text="Fechar" />
			</Button>
		</StackPanel>
	</Grid>
</Window>
